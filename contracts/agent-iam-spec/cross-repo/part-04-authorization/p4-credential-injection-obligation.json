{
  "id": "cr-p4-credential-injection-obligation-001",
  "part": "agent-iam-4-authorization",
  "clause": "8.3",
  "kind": "positive",
  "title": "Credential injection is an explicit obligation that binds a reference, target, scope, and expiry",
  "contract": { "surface": "aegivela.authorization-plane", "version": "aegivela.io/v2.0" },
  "given": {
    "decision": { "outcome": "allow", "action": "orders.call", "resourceRef": "service:orders-api" },
    "obligation": { "type": "credential_injection", "credentialRef": "cred_orders_ro", "target": "https://api.example.com", "scope": ["read:orders"], "expiresAt": "2026-10-04T10:05:00Z" }
  },
  "operation": {
    "http": {
      "method": "POST",
      "path": "/v2/decisions/verify",
      "body": { "signedDecision": "<jws>", "expectedBindings": { "action": "orders.call", "resourceRef": "service:orders-api" } }
    }
  },
  "expected": {
    "outcome": "accept",
    "status": 200,
    "assertions": [
      "the response carries the credential-injection obligation",
      "no credential value appears in the decision or evidence"
    ]
  }
}
