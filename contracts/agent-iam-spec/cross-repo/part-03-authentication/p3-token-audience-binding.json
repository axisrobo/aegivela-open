{
  "id": "cr-p3-token-audience-binding-001",
  "part": "agent-iam-3-authentication",
  "clause": "5.1",
  "threatRef": "T8",
  "kind": "negative",
  "title": "A token issued for one audience is rejected at another",
  "contract": { "surface": "eidovela.registry-consumer", "version": "v3.0" },
  "given": {
    "token": { "aud": "https://api.example.com/orders", "agentEpoch": 7, "identityEpoch": 3 }
  },
  "operation": {
    "http": {
      "method": "POST",
      "path": "/v1/introspect",
      "body": { "token": "<opaque>", "audience": "https://api.example.com/payments" }
    }
  },
  "expected": {
    "outcome": "reject",
    "status": 401,
    "reasonCode": "audience-mismatch",
    "assertions": ["introspection does not return active:true for a different audience"]
  }
}
