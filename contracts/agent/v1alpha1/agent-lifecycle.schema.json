{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegivela.io/contracts/agent/v1alpha1/agent-lifecycle.schema.json",
  "title": "AEGIVELA Agent Lifecycle",
  "anyOf": [
    { "$ref": "#/$defs/agent_register_request" },
    { "$ref": "#/$defs/agent_record" },
    { "$ref": "#/$defs/agent_enroll_request" },
    { "$ref": "#/$defs/agent_enroll_response" },
    { "$ref": "#/$defs/agent_get_request" },
    { "$ref": "https://aegivela.io/contracts/common/v1alpha1/types.schema.json#/$defs/unauthenticated_error" },
    { "$ref": "https://aegivela.io/contracts/common/v1alpha1/types.schema.json#/$defs/authorization_denied_error" },
    { "$ref": "https://aegivela.io/contracts/common/v1alpha1/types.schema.json#/$defs/identity_unavailable_error" }
  ],
  "$defs": {
    "agent_class": {
      "type": "string",
      "enum": ["twin", "service"]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["created", "active", "suspended", "revoked"]
    },
    "enrollment_strategy": {
      "type": "string",
      "enum": ["device_backed", "human_authorized", "api_only"]
    },
    "agent_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "agent_id", "agent_class", "authority_root", "lifecycle_state", "lifecycle_epoch", "maximum_scopes", "workload_selector", "created_at", "updated_at"],
      "properties": {
        "api_version": { "const": "aegivela.io/v1alpha1" },
        "agent_id": { "type": "string", "minLength": 1 },
        "agent_class": { "$ref": "#/$defs/agent_class" },
        "authority_root": { "type": "string", "minLength": 1 },
        "lifecycle_state": { "$ref": "#/$defs/lifecycle_state" },
        "lifecycle_epoch": { "type": "integer", "minimum": 0 },
        "maximum_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "workload_selector": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "agent_register_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "agent_class", "maximum_scopes", "workload_selector"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 },
        "agent_class": { "$ref": "#/$defs/agent_class" },
        "master_id": { "type": "string", "minLength": 1 },
        "organization_authority_root": { "type": "string", "minLength": 1 },
        "maximum_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "workload_selector": { "type": "string", "minLength": 1 }
      }
    },
    "agent_enroll_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategies"],
      "properties": {
        "strategies": {
          "type": "array",
          "items": { "$ref": "#/$defs/enrollment_strategy" },
          "minItems": 1,
          "uniqueItems": true
        },
        "workload_assertion": { "type": "string", "minLength": 1 },
        "bearer_token": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 }
      }
    },
    "agent_enroll_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "agent_id", "lifecycle_state", "lifecycle_epoch", "evidence_ref", "strategies"],
      "properties": {
        "api_version": { "const": "aegivela.io/v1alpha1" },
        "agent_id": { "type": "string", "minLength": 1 },
        "lifecycle_state": { "$ref": "#/$defs/lifecycle_state" },
        "lifecycle_epoch": { "type": "integer", "minimum": 0 },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "strategies": {
          "type": "array",
          "items": { "$ref": "#/$defs/enrollment_strategy" },
          "minItems": 1
        }
      }
    },
    "agent_get_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
