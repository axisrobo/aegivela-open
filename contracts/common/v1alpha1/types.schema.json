{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegivela.io/contracts/common/v1alpha1/types.schema.json",
  "title": "AEGIVELA Common Types",
  "$defs": {
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "actor_ref"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "subject_ref": { "type": "string", "minLength": 1 },
        "actor_ref": { "type": "string", "minLength": 1 },
        "client_id": { "type": "string", "minLength": 1 },
        "workload_ref": { "type": "string", "minLength": 1 },
        "agent_id": { "type": "string", "minLength": 1 },
        "agent_class": { "type": "string" },
        "master_id": { "type": "string", "minLength": 1 },
        "organization_authority_root": { "type": "string", "minLength": 1 },
        "lifecycle_epoch": { "type": "integer", "minimum": 0 },
        "attestation_ref": { "type": "string", "minLength": 1 }
      }
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "pep_header_name": {
      "const": "X-AEGIVELA-PEP"
    },
    "error_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "message"],
      "properties": {
        "error_code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "details": { "type": "array", "items": { "$ref": "#/$defs/error_detail" } }
      }
    },
    "unauthenticated_error": {
      "$ref": "#/$defs/error_detail",
      "properties": {
        "error_code": { "const": "unauthenticated" }
      }
    },
    "identity_unavailable_error": {
      "$ref": "#/$defs/error_detail",
      "properties": {
        "error_code": { "const": "identity_unavailable" }
      }
    },
    "authorization_denied_error": {
      "$ref": "#/$defs/error_detail",
      "properties": {
        "error_code": { "const": "authorization_denied" }
      }
    },
    "revocation_unavailable_error": {
      "$ref": "#/$defs/error_detail",
      "properties": {
        "error_code": { "const": "revocation_unavailable" }
      }
    },
    "decision_unavailable_error": {
      "$ref": "#/$defs/error_detail",
      "properties": {
        "error_code": { "const": "decision_unavailable" }
      }
    }
  }
}
