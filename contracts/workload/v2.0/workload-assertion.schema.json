{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegivela.io/contracts/workload/v2.0/workload-assertion.schema.json",
  "title": "AEGIVELA Workload Assertion API",
  "oneOf": [
    {
      "$ref": "#/$defs/binding_registration"
    },
    {
      "$ref": "#/$defs/assertion_issue_request"
    },
    {
      "$ref": "#/$defs/binding"
    },
    {
      "$ref": "#/$defs/assertion_issue_response"
    },
    {
      "$ref": "#/$defs/jwks"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "binding_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "actorRef",
        "organizationAuthorityRoot",
        "clientId",
        "workloadId",
        "evidenceRef",
        "traceId"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "actorRef": {
          "$ref": "#/$defs/identifier"
        },
        "organizationAuthorityRoot": {
          "$ref": "#/$defs/identifier"
        },
        "clientId": {
          "$ref": "#/$defs/identifier"
        },
        "workloadId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceRef": {
          "$ref": "#/$defs/evidenceRef"
        },
        "traceId": {
          "$ref": "#/$defs/traceId"
        }
      }
    },
    "assertion_issue_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "actorRef",
        "organizationAuthorityRoot",
        "clientId",
        "workloadId",
        "audience",
        "expiresAt",
        "traceId"
      ],
      "properties": {
        "audience": {
          "$ref": "#/$defs/identifier"
        },
        "apiVersion": {
          "$ref": "#/$defs/apiVersion"
        },
        "actorRef": {
          "$ref": "#/$defs/identifier"
        },
        "organizationAuthorityRoot": {
          "$ref": "#/$defs/identifier"
        },
        "clientId": {
          "$ref": "#/$defs/identifier"
        },
        "workloadId": {
          "$ref": "#/$defs/identifier"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "traceId": {
          "$ref": "#/$defs/traceId"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "version",
        "clientId",
        "workloadId",
        "organizationAuthorityRoot",
        "lifecycleState",
        "evidenceRef",
        "createdAt"
      ],
      "properties": {
        "bindingId": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/identifier"
        },
        "lifecycleState": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time"
        },
        "clientId": {
          "$ref": "#/$defs/identifier"
        },
        "workloadId": {
          "$ref": "#/$defs/identifier"
        },
        "organizationAuthorityRoot": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceRef": {
          "$ref": "#/$defs/evidenceRef"
        }
      }
    },
    "assertion_issue_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workloadAssertion"
      ],
      "properties": {
        "workloadAssertion": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "maxLength": 16384
        }
      }
    },
    "jwk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "use",
        "alg",
        "kid",
        "x"
      ],
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "use": {
          "const": "sig"
        },
        "alg": {
          "const": "EdDSA"
        },
        "kid": {
          "$ref": "#/$defs/identifier"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "jwks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/jwk"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "unauthenticated",
            "invalidWorkloadBindingRequest",
            "invalidWorkloadAssertionRequest",
            "workloadBindingUnavailable",
            "workloadAssertionUnavailable"
          ]
        }
      }
    },
    "apiVersion": {
      "const": "aegivela.io/v2.0"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^evidence://[a-z0-9][a-z0-9_-]{0,63}/[a-f0-9]{64}$"
    }
  }
}
