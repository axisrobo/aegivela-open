{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aegivela.io/tool/v2.0/tool-invariant.schema.json",
  "title": "Tool Invariant",
  "description": "Bounds an execution grant to an exact tool implementation (S4).",
  "type": "object",
  "required": [
    "toolId",
    "skillHash",
    "implementationDigest"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "sloClass": {
      "enum": [
        "preDispatch",
        "continuation",
        "connection"
      ]
    },
    "toolId": {
      "type": "string",
      "minLength": 1
    },
    "skillHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementationDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
