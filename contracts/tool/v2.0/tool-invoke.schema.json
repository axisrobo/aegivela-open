{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aegivela.io/tool/v2.0/tool-invoke.schema.json",
  "title": "Tool Invocation",
  "description": "Versioned tool:invoke decision contract binding a grant to an exact tool implementation.",
  "type": "object",
  "required": [
    "apiVersion",
    "bearerToken",
    "action",
    "resource",
    "scope",
    "executionId",
    "toolId",
    "skillHash",
    "implementationDigest",
    "traceId"
  ],
  "properties": {
    "bearerToken": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "const": "tool:invoke"
    },
    "resource": {
      "type": "object",
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approvalArtifact": {
      "type": "string",
      "minLength": 1
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "const": "aegivela.io/v2.0"
    },
    "toolId": {
      "type": "string",
      "minLength": 1
    },
    "skillHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementationDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
