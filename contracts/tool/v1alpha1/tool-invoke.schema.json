{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aegivela.io/tool/v1alpha1/tool-invoke.schema.json",
  "title": "Tool Invocation",
  "description": "Versioned tool:invoke decision contract binding a grant to an exact tool implementation.",
  "type": "object",
  "required": ["api_version", "bearer_token", "action", "resource", "scope", "execution_id", "tool_id", "skill_hash", "implementation_digest", "trace_id"],
  "properties": {
    "api_version": { "const": "aegivela.io/v1alpha1" },
    "bearer_token": { "type": "string", "minLength": 1 },
    "action": { "const": "tool:invoke" },
    "resource": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1 }
    },
    "approval_artifact": { "type": "string", "minLength": 1 },
    "execution_id": { "type": "string", "minLength": 1 },
    "tool_id": { "type": "string", "minLength": 1 },
    "skill_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "implementation_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trace_id": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
