{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/axisrobo/aegivela-open/contracts/identity-source/v1alpha1/verified-principal.schema.json",
  "title": "VerifiedPrincipal",
  "description": "AEGIVELA's normalized verified agent identity context. It carries references and normalized fields only; raw credentials and unrestricted claims never appear here. Only an identity-source Provider may produce this value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "namespace",
    "agent_id",
    "agent_ref",
    "agent_class",
    "authority_binding",
    "authority_root",
    "agent_state",
    "agent_epoch",
    "identity_state",
    "identity_epoch",
    "attestation_ref",
    "credential_generation"
  ],
  "properties": {
    "tenant_id": { "type": "string", "minLength": 1 },
    "namespace": { "type": "string", "minLength": 1 },
    "subject_ref": { "type": "string" },
    "actor_id": { "type": "string" },
    "client_id": { "type": "string" },
    "agent_id": { "type": "string", "minLength": 1 },
    "agent_ref": { "type": "string", "minLength": 1 },
    "agent_class": { "enum": ["twin", "service", "ephemeral", "simulation"] },
    "authority_binding": { "enum": ["human_master", "organization_root"] },
    "authority_root": { "type": "string", "minLength": 1 },
    "master_id": { "type": "string" },
    "agent_state": { "const": "active" },
    "agent_epoch": { "type": "integer", "minimum": 1 },
    "identity_state": { "enum": ["active", "bound"] },
    "identity_epoch": { "type": "integer", "minimum": 1 },
    "instance_id": { "type": "string" },
    "attestation_ref": { "type": "string", "minLength": 1 },
    "credential_generation": { "type": "integer", "minimum": 1 },
    "identity_assurance": { "type": "string" },
    "session_ref": { "type": "string" },
    "issuer": { "type": "string" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
