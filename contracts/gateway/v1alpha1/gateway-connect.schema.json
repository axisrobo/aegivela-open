{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegivela.io/contracts/gateway/v1alpha1/gateway-connect.schema.json",
  "title": "AEGIVELA Gateway Connect Contract",
  "oneOf": [
    {"$ref": "#/$defs/connect_request"},
    {"$ref": "#/$defs/connect_response"},
    {"$ref": "https://aegivela.io/contracts/common/v1alpha1/types.schema.json#/$defs/unauthenticated_error"},
    {"$ref": "https://aegivela.io/contracts/common/v1alpha1/types.schema.json#/$defs/authorization_denied_error"},
    {"$ref": "https://aegivela.io/contracts/common/v1alpha1/types.schema.json#/$defs/identity_unavailable_error"}
  ],
  "$defs": {
    "api_version": {"const": "aegivela.io/v1alpha1"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "compact_token": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$", "maxLength": 16384},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "action": {"type": "string", "enum": ["connection:open", "backend:request", "credential:inject", "tool:invoke"]},
    "outcome": {"type": "string", "enum": ["allow", "deny", "approval_required", "revoked"]},
    "agent_class": {"type": "string", "enum": ["twin", "service"]},
    "connect_request": {
      "type": "object", "additionalProperties": false,
      "required": ["api_version", "action", "tenant_id", "agent_id", "agent_class", "workload_assertion", "target_host", "target_scheme", "requested_scope", "audience", "trace_id"],
      "properties": {
        "api_version": {"$ref": "#/$defs/api_version"},
        "action": {"$ref": "#/$defs/action"},
        "tenant_id": {"$ref": "#/$defs/identifier"},
        "agent_id": {"$ref": "#/$defs/identifier"},
        "agent_class": {"$ref": "#/$defs/agent_class"},
        "workload_assertion": {"$ref": "#/$defs/compact_token"},
        "attribution": {"$ref": "#/$defs/tool_attribution"},
        "argument_digest": {"type": "string", "minLength": 1},
        "argument_classification": {"type": "string", "minLength": 1},
        "target_host": {"type": "string", "minLength": 1},
        "target_scheme": {"type": "string", "enum": ["http", "https"]},
        "target_path": {"type": "string", "minLength": 1},
        "requested_scope": {"$ref": "#/$defs/scope"},
        "audience": {"$ref": "#/$defs/identifier"},
        "trace_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "tool_attribution": {
      "type": "object", "additionalProperties": false,
      "required": ["human_ref", "agent_ref", "tool_id", "skill_hash", "implementation_digest"],
      "properties": {
        "human_ref": {"$ref": "#/$defs/identifier"},
        "agent_ref": {"$ref": "#/$defs/identifier"},
        "tool_id": {"$ref": "#/$defs/identifier"},
        "skill_hash": {"type": "string", "minLength": 1, "pattern": "^sha256:[a-f0-9]{64}$"},
        "implementation_digest": {"type": "string", "minLength": 1, "pattern": "^sha256:[a-f0-9]{64}$"},
        "signed_at": {"type": "string", "format": "date-time"},
        "signature": {"type": "string", "minLength": 1}
      }
    },
    "connect_response": {
      "type": "object", "additionalProperties": false,
      "required": ["api_version", "decision_id", "outcome", "policy_version", "expires_at", "ttl_seconds", "offline_eligible", "evidence_refs"],
      "properties": {
        "api_version": {"$ref": "#/$defs/api_version"},
        "decision_id": {"type": "string", "minLength": 1},
        "outcome": {"$ref": "#/$defs/outcome"},
        "policy_version": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "format": "date-time"},
        "ttl_seconds": {"type": "integer", "minimum": 0, "maximum": 3600},
        "offline_eligible": {"type": "boolean"},
        "scope": {"$ref": "#/$defs/scope"},
        "obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "credential_ref": {"type": "string", "minLength": 1},
        "credential_class": {"type": "string", "enum": ["aws_sigv4", "header", "query", "body"]},
        "mitm_required": {"type": "boolean"},
        "mitm_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "allowed_target_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
