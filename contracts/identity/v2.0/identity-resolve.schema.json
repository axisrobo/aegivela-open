{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegivela.io/contracts/identity/v2.0/identity-resolve.schema.json",
  "title": "AEGIVELA Identity Resolve",
  "oneOf": [
    {
      "$ref": "#/$defs/identity_resolve_request"
    },
    {
      "$ref": "#/$defs/identity_resolve_response"
    },
    {
      "$ref": "https://aegivela.io/contracts/common/v2.0/types.schema.json#/$defs/unauthenticated_error"
    },
    {
      "$ref": "https://aegivela.io/contracts/common/v2.0/types.schema.json#/$defs/identity_unavailable_error"
    }
  ],
  "$defs": {
    "identity_resolve_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "bearerToken",
        "audience"
      ],
      "properties": {
        "bearerToken": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "apiVersion": {
          "const": "aegivela.io/v2.0"
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "identity_resolve_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "principal"
      ],
      "properties": {
        "principal": {
          "$ref": "https://aegivela.io/contracts/common/v2.0/types.schema.json#/$defs/principal"
        },
        "apiVersion": {
          "const": "aegivela.io/v2.0"
        }
      }
    }
  }
}
